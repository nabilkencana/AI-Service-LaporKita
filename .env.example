# Application Environment
APP_NAME="LaporKita AI Service"
APP_ENV=development
VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# API Prefix & Internal Auth
API_V1_STR=/v1
INTERNAL_API_KEY=laporkita-a0de63d362f6bb7e9b7fa125a0452196

# AI Verification Thresholds (Rules.md §1.2)
# ai_confidence_score < 0.6 -> needs_manual_review = True
AI_CONFIDENCE_THRESHOLD=0.6
AI_CONFIDENCE_AUTO_THRESHOLD=0.85

# Pilot Area Bounding Box (Kota Malang)
MALANG_BBOX_MIN_LAT=-8.0500
MALANG_BBOX_MAX_LAT=-7.9000
MALANG_BBOX_MIN_LON=112.5500
MALANG_BBOX_MAX_LON=112.7000

# Smart Priority Weights (Rules.md §1.3)
WEIGHT_DAMAGE_SEVERITY=0.35
WEIGHT_SUPPORT_COUNT=0.25
WEIGHT_LOCATION_DENSITY=0.20
WEIGHT_CATEGORY_URGENCY=0.20

# DeepSeek API (Policy Simulator - Primary LLM Provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# Google Gemini API Key (Policy Simulator - Optional Fallback)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Model Weights Paths (Phases 3-4)
CLASSIFICATION_MODEL_PATH=models/yolov11-cls-laporkita.pt
XGBOOST_MODEL_PATH=models/xgboost-flood-risk.json
