# Application Environment
APP_NAME="LaporKita AI Service"
APP_ENV=development
VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# API Prefix
API_V1_STR=/v1

# AI Verification Thresholds (Rules.md §1.2)
# ai_confidence_score < 0.6 -> needs_manual_review = True
AI_CONFIDENCE_THRESHOLD=0.6

# Pilot Area Bounding Box (Kota Malang)
MALANG_BBOX_MIN_LAT=-8.0500
MALANG_BBOX_MAX_LAT=-7.9000
MALANG_BBOX_MIN_LON=112.5500
MALANG_BBOX_MAX_LON=112.7000

# Smart Priority Weights (Rules.md §1.3)
WEIGHT_DAMAGE_SEVERITY=0.35
WEIGHT_SUPPORT_COUNT=0.25
WEIGHT_LOCATION_DENSITY=0.20
WEIGHT_CATEGORY_URGENCY=0.20

# Google Gemini API Key (Policy Simulator - Phase 5)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Model Weights Paths (Phases 3-4)
CLASSIFICATION_MODEL_PATH=models/yolo11_cls_best.pt
XGBOOST_MODEL_PATH=models/xgboost_risk_model.json
