            "description": "Health check status service, environment, dan kesiapan model YOLO, XGBoost, DeepSeek."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
